{
  "expo": {
    "name": "Automatos Go",
    "slug": "automatos-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "automatos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.automatos.app",
      "icon": {
        "light": "./assets/brand/icon.png",
        "dark": "./assets/brand/icon-dark.png"
      },
      "associatedDomains": ["applinks:ui.automatos.app", "webcredentials:clerk.automatos.app"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "Automatos Go uses the camera to scan the QR code that connects it to your server, and to take photos you send to Auto.",
        "NSMicrophoneUsageDescription": "Automatos Go uses the microphone when you talk to Auto.",
        "NSSpeechRecognitionUsageDescription": "Automatos Go turns what you say to Auto into text, using speech recognition on this iPhone.",
        "NSPhotoLibraryUsageDescription": "Automatos Go lets you choose photos from your library to attach to a message for Auto.",
        "NSFaceIDUsageDescription": "Automatos Go asks for Face ID before you approve a request or answer a question in your workspace.",
        "NSLocalNetworkUsageDescription": "Automatos Go connects to your own Automatos server when it runs on your home or office network.",
        "NSPhotoLibraryAddUsageDescription": "Automatos Go does not save anything to your photo library; a bundled library references it, so Apple requires this notice; the app never asks for access.",
        "NSMotionUsageDescription": "Automatos Go does not use motion data; a bundled library references it, so Apple requires this notice; the app never asks for access."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCustomerSupport",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUsageData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherDiagnosticData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["85F4.1", "E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["0A2A.1", "3B52.1", "C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.automatos.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#f4eee2"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ui.automatos.app",
              "pathPrefix": "/go"
            },
            {
              "scheme": "https",
              "host": "ui.automatos.app",
              "pathPrefix": "/command-center"
            },
            {
              "scheme": "https",
              "host": "ui.automatos.app",
              "pathPrefix": "/chat"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": true
        }
      ],
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-speech-recognition",
        {
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://de.sentry.io/"
        }
      ],
      "expo-localization",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4eee2",
          "image": "./assets/brand/splash.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#1a1814"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/bricolage-grotesque/BricolageGrotesque96ptExtraBold-Bold.ttf",
            "./assets/fonts/chakra-petch/ChakraPetch-Medium.ttf",
            "./assets/fonts/chakra-petch/ChakraPetch-SemiBold.ttf",
            "./assets/fonts/fredoka/FredokaLight-SemiBold.ttf",
            "./assets/fonts/geist/Geist-Medium.ttf",
            "./assets/fonts/geist/Geist-Regular.ttf",
            "./assets/fonts/geist/Geist-SemiBold.ttf",
            "./assets/fonts/geist-mono/GeistMono-Medium.ttf",
            "./assets/fonts/geist-mono/GeistMono-Regular.ttf",
            "./assets/fonts/geist-mono/GeistMono-SemiBold.ttf",
            "./assets/fonts/instrument-serif/InstrumentSerif-Italic.ttf",
            "./assets/fonts/instrument-serif/InstrumentSerif-Regular.ttf",
            "./assets/fonts/newsreader/Newsreader16pt16pt-Italic.ttf",
            "./assets/fonts/newsreader/Newsreader16pt16pt-Medium.ttf",
            "./assets/fonts/newsreader/Newsreader16pt16pt-MediumItalic.ttf",
            "./assets/fonts/newsreader/Newsreader16pt16pt-Regular.ttf",
            "./assets/fonts/newsreader/Newsreader16pt16pt-SemiBold.ttf",
            "./assets/fonts/rajdhani/Rajdhani-Bold.ttf",
            "./assets/fonts/rajdhani/Rajdhani-Medium.ttf",
            "./assets/fonts/rajdhani/Rajdhani-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "packagingOptions": {
              "exclude": ["META-INF/versions/9/OSGI-INF/MANIFEST.MF"]
            }
          },
          "ios": {
            "deploymentTarget": "17.0",
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "./plugins/with-pinned-background-modes",
      "./plugins/with-sentry-upload-guard"
    ],
    "extra": {
      "router": {}
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
