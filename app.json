{
  "expo": {
    "name": "Automatos Go",
    "slug": "automatos-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "automatos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.automatos.app",
      "associatedDomains": ["applinks:ui.automatos.app", "webcredentials:clerk.automatos.app"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.automatos.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ui.automatos.app",
              "pathPrefix": "/go"
            },
            {
              "scheme": "https",
              "host": "ui.automatos.app",
              "pathPrefix": "/command-center"
            },
            {
              "scheme": "https",
              "host": "ui.automatos.app",
              "pathPrefix": "/chat"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": true
        }
      ],
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-speech-recognition",
        {
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://de.sentry.io/"
        }
      ],
      "expo-localization",
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "exclude": ["META-INF/versions/9/OSGI-INF/MANIFEST.MF"]
            }
          },
          "ios": {
            "deploymentTarget": "17.0",
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "./plugins/with-pinned-background-modes",
      "./plugins/with-sentry-upload-guard"
    ],
    "extra": {
      "router": {}
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
